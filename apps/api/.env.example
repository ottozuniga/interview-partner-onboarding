# Copy to apps/api/.env and adjust. On a stock Homebrew Postgres install the
# role is your macOS username with trust auth (no password), so the URL is
# typically:  postgresql://$(whoami)@localhost:5432/onboarding_dev?schema=public
DATABASE_URL="postgresql://postgres@localhost:5432/onboarding_dev?schema=public"

# Used only by the test suite. Must be a DIFFERENT database — the suite
# truncates tables between tests and resets the schema on start.
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/onboarding_test?schema=public"

PORT=3000
WEB_ORIGIN="http://localhost:5173"

# The single hardcoded partner (auth is out of scope). Seeded by `pnpm db:seed`.
PARTNER_NAME="CompanyABC"

# How long we wait on the Provider before treating the call as a transient failure.
PROVIDER_TIMEOUT_MS=5000

# Artificial Provider latency, so the RUNNING state is actually observable in
# the UI and double-click deduplication is demonstrable by hand.
PROVIDER_LATENCY_MS=1200

# Grace added to PROVIDER_TIMEOUT_MS before a still-RUNNING attempt is considered
# abandoned (e.g. the server was killed mid-call) and reaped as transient.
ATTEMPT_STALE_GRACE_MS=15000
